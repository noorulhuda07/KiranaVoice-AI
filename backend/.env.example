# Get the key from https://app.gnani.ai/voice  (Prisma v2.5 + Timbre keys). Backend only, never in frontend.
GNANI_API_KEY=
GNANI_STT_LANGUAGE=hi-IN
# Optional, Prisma v3.0 only (gives Latin-script Hinglish, easier for the parser):
# GNANI_STT_MODEL=prisma-v3.0
# GNANI_STT_FORMAT=transliterate
GNANI_TTS_MODEL=timbre-v2.5
GNANI_TTS_VOICE=Nalini
GNANI_TTS_LANGUAGE=hi-IN
FRONTEND_ORIGIN=http://localhost:5173
LARGE_CHANGE_THRESHOLD=100
